APP_NAME=ORCA Base API
APP_ENV=development
API_PREFIX=/v1
# Explicit browser origins for the F0 frontend. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Redis is optional. Leave false to use the in-memory cache.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
HTTP_RETRY_ATTEMPTS=3

INCOIS_BASE_URL=https://incois.gov.in/MarineFisheries
PFZ_FETCH_CONCURRENCY=4
PFZ_CACHE_TTL_SECONDS=1800
PFZ_STALE_TTL_SECONDS=86400

# Copernicus Marine SST is optional. Install the "copernicus" extra first.
COPERNICUS_SST_ENABLED=false
COPERNICUS_SST_DATASET_ID=METOFFICE-GLO-SST-L4-NRT-OBS-SST-V2
COPERNICUS_SST_VARIABLE=analysed_sst
COPERNICUS_SST_SEARCH_RADIUS_KM=50
COPERNICUS_SST_LOOKBACK_DAYS=3
COPERNICUS_SST_CACHE_TTL_SECONDS=21600
COPERNICUS_SST_STALE_TTL_SECONDS=86400

# Process-local regional snapshots. P1A SST and P1B-1 chlorophyll are opt-in.
MARINE_SNAPSHOTS_ENABLED=false
MARINE_SNAPSHOT_TILE_SIZE_DEGREES=2.0
MARINE_SNAPSHOT_HEAVY_CONCURRENCY=2
MARINE_SNAPSHOT_WAIT_TIMEOUT_SECONDS=90
MARINE_SNAPSHOT_SCHEDULER_CHECK_SECONDS=60
MARINE_SNAPSHOT_STARTUP_WARM_ENABLED=false
MARINE_SNAPSHOT_MAX_STALE_SECONDS=172800
MARINE_SNAPSHOT_JOB_RETENTION_SECONDS=3600
SST_SNAPSHOT_REFRESH_CHECK_SECONDS=21600
SST_SNAPSHOT_FRESH_SECONDS=86400
SST_SNAPSHOT_TIME_LOOKBACK_DAYS=3
SST_SNAPSHOT_RETRYABLE_BASE_DELAY_SECONDS=30
SST_SNAPSHOT_RETRYABLE_MAX_DELAY_SECONDS=900
SST_SNAPSHOT_NON_RETRYABLE_COOLDOWN_SECONDS=900
CHLOROPHYLL_SNAPSHOTS_ENABLED=false
CHLOROPHYLL_SNAPSHOT_STARTUP_WARM_ENABLED=false
CHLOROPHYLL_SNAPSHOT_REFRESH_CHECK_SECONDS=21600
CHLOROPHYLL_SNAPSHOT_FRESH_SECONDS=86400
CHLOROPHYLL_SNAPSHOT_MAX_STALE_SECONDS=172800
CHLOROPHYLL_SNAPSHOT_SCHEMA_VERSION=chlorophyll-snapshot-v1
# Example: [{"latitude":18.025,"longitude":70.525},{"latitude":20.5,"longitude":72.9}]
MARINE_SNAPSHOT_PREWARM_POINTS_JSON=[]
COPERNICUS_WAVES_ENABLED=false
COPERNICUS_WAVES_DATASET_ID=cmems_mod_glo_wav_anfc_0.083deg_PT3H-i
COPERNICUS_WAVES_HEIGHT_VARIABLE=VHM0
COPERNICUS_WAVES_PERIOD_VARIABLE=VTM02
COPERNICUS_WAVES_DIRECTION_VARIABLE=VMDR
COPERNICUS_WAVES_SEARCH_RADIUS_KM=50
COPERNICUS_WAVES_TIME_TOLERANCE_HOURS=3
COPERNICUS_WAVES_CACHE_TTL_SECONDS=3600
COPERNICUS_WAVES_STALE_TTL_SECONDS=21600
COPERNICUS_WAVES_CYCLE_CACHE_TTL_SECONDS=3600

# Copernicus Marine NRT wind is optional and is not a forecast source.
COPERNICUS_WIND_ENABLED=false
COPERNICUS_WIND_DATASET_ID=cmems_obs-wind_glo_phy_nrt_l4_0.125deg_PT1H
COPERNICUS_WIND_EASTWARD_VARIABLE=eastward_wind
COPERNICUS_WIND_NORTHWARD_VARIABLE=northward_wind
COPERNICUS_WIND_SEARCH_RADIUS_KM=50
COPERNICUS_WIND_MAX_AGE_HOURS=30
COPERNICUS_WIND_CACHE_TTL_SECONDS=3600
COPERNICUS_WIND_STALE_TTL_SECONDS=21600

# Copernicus Marine L4 gap-filled chlorophyll is optional.
CHLOROPHYLL_ENABLED=true
CHLOROPHYLL_DATASET_ID=cmems_obs-oc_glo_bgc-plankton_nrt_l4-gapfree-multi-4km_P1D
CHLOROPHYLL_DATASET_VERSION=202311
CHLOROPHYLL_VARIABLE=CHL
CHLOROPHYLL_UNCERTAINTY_VARIABLE=CHL_uncertainty
CHLOROPHYLL_FLAGS_VARIABLE=flags
CHLOROPHYLL_MAX_RADIUS_KM=10
CHLOROPHYLL_CACHE_TTL_SECONDS=21600
CHLOROPHYLL_MAX_STALE_SECONDS=86400
CHLOROPHYLL_FRESHNESS_HOURS=72
CHLOROPHYLL_HIGH_UNCERTAINTY_PERCENT=50

# Copernicus Marine SMOC total surface currents are optional.
COPERNICUS_CURRENTS_ENABLED=false
COPERNICUS_CURRENTS_DATASET_ID=cmems_mod_glo_phy_anfc_merged-uv_PT1H-i
COPERNICUS_CURRENTS_DATASET_VERSION=202211
COPERNICUS_CURRENTS_STATIC_DATASET_ID=cmems_mod_glo_phy_anfc_0.083deg_static
COPERNICUS_CURRENTS_STATIC_DATASET_VERSION=202211
COPERNICUS_CURRENTS_MAX_RADIUS_KM=15
COPERNICUS_CURRENTS_CALM_THRESHOLD_MPS=0.001
COPERNICUS_CURRENTS_TIME_TOLERANCE_HOURS=1
COPERNICUS_CURRENTS_COMPONENT_TOLERANCE_MPS=0.002
COPERNICUS_CURRENTS_CACHE_TTL_SECONDS=1800
COPERNICUS_CURRENTS_STALE_TTL_SECONDS=21600
COPERNICUS_CURRENTS_MAX_HORIZON_HOURS=240

# Copernicus Marine modelled sea level and astronomical tide are optional.
COPERNICUS_TIDES_ENABLED=false
COPERNICUS_TIDES_DATASET_ID=cmems_mod_glo_phy_anfc_merged-sl_PT1H-i
COPERNICUS_TIDES_DATASET_VERSION=202411
COPERNICUS_TIDES_STATIC_DATASET_ID=cmems_mod_glo_phy_anfc_0.083deg_static
COPERNICUS_TIDES_STATIC_DATASET_VERSION=202211
COPERNICUS_TIDES_STATIC_DATASET_PART=bathy
COPERNICUS_TIDES_MAX_RADIUS_KM=10
COPERNICUS_TIDES_STATIC_ALIGNMENT_TOLERANCE_KM=1
COPERNICUS_TIDES_TIME_TOLERANCE_HOURS=1
COPERNICUS_TIDES_DECOMPOSITION_TOLERANCE_M=0.005
COPERNICUS_TIDES_CACHE_TTL_SECONDS=1800
COPERNICUS_TIDES_STALE_TTL_SECONDS=21600
COPERNICUS_TIDES_STATIC_CACHE_TTL_SECONDS=604800
COPERNICUS_TIDES_METADATA_CACHE_TTL_SECONDS=3600
COPERNICUS_TIDES_METADATA_UNAVAILABLE_TTL_SECONDS=600
COPERNICUS_TIDES_AVAILABILITY_TTL_SECONDS=600
COPERNICUS_TIDES_EVENT_CACHE_TTL_SECONDS=1800
COPERNICUS_TIDES_MINIMUM_CONSECUTIVE_SAMPLES=3
COPERNICUS_TIDES_MAX_HORIZON_HOURS=240

# ECMWF IFS deterministic wind forecast is optional and needs no credentials.
ECMWF_WIND_ENABLED=false
ECMWF_WIND_MODEL=ifs
ECMWF_WIND_RESOLUTION=0p25
ECMWF_WIND_U_PARAMETER=10u
ECMWF_WIND_V_PARAMETER=10v
ECMWF_WIND_PRIMARY_SOURCE=ecmwf
ECMWF_WIND_FALLBACK_SOURCE=aws
ECMWF_WIND_MAX_RETRIES=2
ECMWF_WIND_RETRY_INITIAL_SECONDS=1
ECMWF_WIND_RETRY_MAX_SECONDS=8
ECMWF_WIND_CONNECT_TIMEOUT_SECONDS=10
ECMWF_WIND_READ_TIMEOUT_SECONDS=50
ECMWF_WIND_CALM_THRESHOLD_MPS=0.001
ECMWF_WIND_MAX_HORIZON_HOURS=360
ECMWF_WIND_CYCLE_CACHE_TTL_SECONDS=900
ECMWF_WIND_CYCLE_STALE_TTL_SECONDS=3600
ECMWF_WIND_FIELD_CACHE_TTL_SECONDS=3600
ECMWF_WIND_FIELD_CACHE_MAX_ENTRIES=3
ECMWF_WIND_FIELD_CACHE_MAX_BYTES=67108864
ECMWF_WIND_POINT_CACHE_TTL_SECONDS=3600
ECMWF_WIND_POINT_STALE_TTL_SECONDS=21600
ECMWF_WIND_MAX_STALE_CYCLE_AGE_HOURS=24
ECMWF_WIND_MAX_DOWNLOAD_BYTES=10485760

# Optional Toolbox login values. Leave empty when using a saved local login.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Opt-in local diagnostics. Server-Timing is intentionally disabled by default.
PERFORMANCE_DIAGNOSTICS_ENABLED=false
PERFORMANCE_SERVER_TIMING_ENABLED=false
PERFORMANCE_LOG_SLOW_REQUEST_MS=1000
PERFORMANCE_PROFILE_MAX_PROVIDER_CONCURRENCY=2

# Deterministic E1 evidence aggregation. Source providers retain their own flags.
EVIDENCE_AGGREGATION_ENABLED=true
EVIDENCE_MAX_CONCURRENT_SOURCES=7
