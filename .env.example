APP_NAME=ORCA Base API
APP_ENV=development
API_PREFIX=/v1

# Use your Supabase pooler/direct PostgreSQL URL when ready.
DATABASE_URL=

# Leave false until Redis is running.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
HTTP_RETRY_ATTEMPTS=3

INCOIS_BASE_URL=https://incois.gov.in/MarineFisheries
PFZ_SECTOR_CODES=SEC001,SEC002
PFZ_SESSION_ATTEMPTS=2
