# ORCA Marine Intelligence Frontend Environment Configuration

# Production backend API URL (Point to your deployed backend or local server)
NEXT_PUBLIC_ORCA_API_BASE_URL=http://localhost:8000

# MapLibre vector tile style endpoint (Free open vector tiles, or custom Mapbox/Cloudflare style)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Assistant operational mode: live | demo | disabled
NEXT_PUBLIC_ORCA_ASSISTANT_MODE=live

# Feature flags
NEXT_PUBLIC_ORCA_DEMO_MODE=false
NEXT_PUBLIC_ORCA_PRESENTATION_MODE=false
NEXT_PUBLIC_ORCA_DEV_DIAGNOSTICS=false

# Client-side request timeout in milliseconds
NEXT_PUBLIC_ORCA_REQUEST_TIMEOUT_MS=90000

